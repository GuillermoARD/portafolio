# Copia este archivo como .env y rellena lo que necesites.

PORT=3001
# Origen permitido para CORS (la URL del front). Varios separados por comas.
CORS_ORIGIN=http://localhost:5173
# Pon 1 si el servidor va detrás de un proxy (Render, Railway, Nginx...) para que el rate limit vea la IP real.
TRUST_PROXY=0

# --- Panel /admin ---
# Sin ADMIN_PASSWORD el panel queda desactivado. Usa una contraseña larga y única.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Clave para firmar las sesiones (mínimo 32 caracteres; obligatoria en producción).
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Horas que dura la sesión del panel
SESSION_HOURS=8

# --- Base de datos (Sequelize) ---
# Vacío = SQLite local en server/data/portafolio.sqlite
# Producción: postgres://usuario:clave@host:5432/basedatos  (o mysql://... instalando mysql2)
DATABASE_URL=
# Pon true si tu proveedor de Postgres exige SSL (Render, Neon, Supabase...)
DB_SSL=false
SQLITE_FILE=data/portafolio.sqlite

# --- Correo del formulario ---
# Proveedor: test | resend | smtp
# "test" no envía nada: muestra el mensaje en consola y lo guarda en server/outbox/messages.jsonl
MAIL_PROVIDER=test
# Correo donde quieres recibir los mensajes
CONTACT_TO=guillermoadr29@gmail.com
# Remitente. Con Resend sin dominio verificado usa: Portafolio <onboarding@resend.dev>
CONTACT_FROM=Portafolio <onboarding@resend.dev>

# Resend (https://resend.com)
RESEND_API_KEY=

# SMTP / Nodemailer (ej. Gmail con contraseña de aplicación)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
